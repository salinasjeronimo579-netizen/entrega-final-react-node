id="p4_b2" value="&lt;b&gt;Qué se muestra aquí&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Solo las clases del dominio, no las tablas de catálogo (roles, estados, países, etc. son detalle de persistencia, no del modelo de negocio).&lt;br&gt;· Atributos con su tipo.&lt;br&gt;· Cardinalidad en los dos extremos de cada relación.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pregunta guía:&lt;/b&gt; ¿esta clase existiría si apagáramos el computador? Si la respuesta es sí, es del dominio y va aquí." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="950" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. UML Secuencia" id="d5"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_b1" value="&lt;b&gt;UML · Diagrama de secuencia — caso de uso «Registrar préstamo»&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p5_b2" value="Bibliotecario" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_e1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="160" as="sourcePoint"/><mxPoint x="120" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_b3" value="Aplicación web" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_e2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="160" as="sourcePoint"/><mxPoint x="350" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_b4" value="API REST" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_e3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="160" as="sourcePoint"/><mxPoint x="590" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_b5" value="Service de Préstamos" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_e4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="160" as="sourcePoint"/><mxPoint x="830" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_b6" value="Base de datos" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="990" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_e5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="160" as="sourcePoint"/><mxPoint x="1080" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e6" value="1. Selecciona usuario y ejemplar, pulsa «Registrar préstamo»" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint"/><mxPoint x="350" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e7" value="2. POST /prestamos {usuarioId, ejemplarId} + token" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="250" as="sourcePoint"/><mxPoint x="590" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e8" value="3. registrarPrestamo(usuario, ejemplar)" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="310" as="sourcePoint"/><mxPoint x="830" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e9" value="4. SELECT ejemplar y préstamos activos del usuario" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="370" as="sourcePoint"/><mxPoint x="1080" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e10" value="5. devuelve disponibilidad y conteo de préstamos" style="html=1;endArrow=open;dashed=1;fontSize=10;verticalAlign=bottom;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="420" as="sourcePoint"/><mxPoint x="830" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e11" value="6. INSERT préstamo + UPDATE estado del ejemplar" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="470" as="sourcePoint"/><mxPoint x="1080" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e12" value="7. commit correcto" style="html=1;endArrow=open;dashed=1;fontSize=10;verticalAlign=bottom;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="510" as="sourcePoint"/><mxPoint x="830" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e13" value="8. préstamo registrado" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="560" as="sourcePoint"/><mxPoint x="590" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e14" value="9. 201 Created {prestamo}" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="610" as="sourcePoint"/><mxPoint x="350" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e15" value="10. muestra confirmación" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="660" as="sourcePoint"/><mxPoint x="120" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_b7" value="&lt;b&gt;Qué responde este diagrama&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cómo colaboran los contenedores y componentes para cumplir el requerimiento «registro de préstamos de libros a usuarios autorizados», incluyendo la validación de disponibilidad antes de confirmar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="900" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6. UML Despliegue" id="d6"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_b1" value="&lt;b&gt;UML · Diagrama de despliegue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p6_b2" value="&lt;b&gt;Equipo de desarrollo&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;portátil / escritorio — localhost&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fontSize=12;verticalAlign=top;spacingTop=6;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="700" height="300" as="geometry"/></mxCell><mxCell id="p6_b3" value="Navegador&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Chrome / Edge / Firefox&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="230" y="220" width="200" height="70" as="geometry"/></mxCell><mxCell id="p6_b4" value="Servidor de desarrollo Vite&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Aplicación web React · puerto 5173&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="230" y="320" width="200" height="70" as="geometry"/></mxCell><mxCell id="p6_b5" value="API REST&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Node.js + Express · puerto 3000&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="p6_b6" value="PostgreSQL&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;instancia local / contenedor Docker&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="220" height="70" as="geometry"/></mxCell><mxCell id="p6_e1" value="HTTP · puerto 5173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="p6_b3" target="p6_b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6_e2" value="HTTP/JSON · puerto 3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="p6_b4" target="p6_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6_e3" value="TCP · puerto 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="p6_b5" target="p6_b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6_b7" value="&lt;b&gt;Qué responde este diagrama&lt;/b&gt;&lt;br&gt;&lt;br&gt;¿Dónde corre cada contenedor del nivel 2 de C4? Aquí sí se habla de máquinas, puertos y procesos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Estado actual de Booker:&lt;/b&gt; el proyecto se ejecuta en el equipo de desarrollo (frontend con Vite, backend Node.js con Express, base de datos PostgreSQL local). El despliegue en un servidor/nube queda como trabajo futuro — eso es honesto y es correcto en esta etapa del proyecto." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="480" width="700" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7. Escenario de calidad" id="d7"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7_b1" value="&lt;b&gt;Escenario de calidad — Autorización por rol&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p7_b2" value="&lt;b&gt;1. Fuente del estímulo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b3" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿Quién o qué origina la situación?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b4" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;Un usuario autenticado con rol «Usuario» (estudiante o docente)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b5" value="&lt;b&gt;2. Estímulo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b6" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿Qué ocurre exactamente?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="196" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b7" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;Intenta acceder a un endpoint de gestión de usuarios (crear, editar o eliminar cuentas), reservado para el rol «Administrador»&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="196" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b8" value="&lt;b&gt;3. Entorno&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b9" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿En qué condiciones?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="272" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b10" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;Operación normal del sistema&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="272" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b11" value="&lt;b&gt;4. Artefacto&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="348" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b12" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿Qué parte del sistema se ve afectada?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="348" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b13" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;El componente de Seguridad (JWT + bcrypt) y el Controller de Usuarios de la API REST&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="348" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b14" value="&lt;b&gt;5. Respuesta&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b15" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿Qué debe hacer el sistema?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="424" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b16" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;Rechazar la petición sin ejecutar la operación ni exponer datos de otros usuarios&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="424" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b17" value="&lt;b&gt;6. Medida&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="230" height="76" as="geometry"/></mxCell><mxCell id="p7_b18" value="&lt;font style=&#x27;font-size:11px&#x27;&gt;¿Cómo se comprueba? (número + unidad)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="290" y="500" width="330" height="76" as="geometry"/></mxCell><mxCell id="p7_b19" value="&lt;i style=&#x27;font-size:11px&#x27;&gt;Responde 403 Forbidden en menos de 200 ms en el 100 % de los intentos no autorizados&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="440" height="76" as="geometry"/></mxCell><mxCell id="p7_b20" value="&lt;b&gt;Prueba del algodón:&lt;/b&gt; la parte 6 tiene un número y una unidad (403, 200 ms, 100 %): sirve para justificar una decisión de arquitectura. «Seguro» solo no bastaría.&lt;br&gt;&lt;br&gt;&lt;b&gt;La tensión:&lt;/b&gt; validar el rol en cada petición agrega una consulta/verificación extra en el middleware de Seguridad, lo que puede afectar levemente el tiempo de respuesta (rendimiento) a cambio de garantizar el control de acceso por rol que exige el sistema." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="616" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8. Mapa 4+1 y C4" id="d8"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_b1" value="&lt;b&gt;Mapa — Vistas 4+1, modelo C4 y diagramas UML&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p8_b2" value="Vista 4+1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#1F5C2E;fontColor=#FFFFFF;strokeColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="160" height="46" as="geometry"/></mxCell><mxCell id="p8_b3" value="¿Qué pregunta responde?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#1F5C2E;fontColor=#FFFFFF;strokeColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="320" height="46" as="geometry"/></mxCell><mxCell id="p8_b4" value="Nivel de C4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#1F5C2E;fontColor=#FFFFFF;strokeColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="200" height="46" as="geometry"/></mxCell><mxCell id="p8_b5" value="Diagrama UML" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#1F5C2E;fontColor=#FFFFFF;strokeColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="200" height="46" as="geometry"/></mxCell><mxCell id="p8_b6" value="¿A quién le interesa?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#1F5C2E;fontColor=#FFFFFF;strokeColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="200" height="46" as="geometry"/></mxCell><mxCell id="p8_b7" value="Lógica" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8_b8" value="¿Qué hace el sistema y cómo se organiza el dominio?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="166" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8_b9" value="Nivel 3 — Componentes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="166" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b10" value="Clases" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="166" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b11" value="Desarrolladores" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="166" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b12" value="De procesos" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8_b13" value="¿Qué pasa en tiempo de ejecución?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="236" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8_b14" value="Nivel 2 — Contenedores" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="236" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b15" value="Secuencia" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="236" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b16" value="Arquitecto · QA" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="236" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b17" value="De desarrollo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="306" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8_b18" value="¿Cómo se organiza el código?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="306" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8_b19" value="Nivel 3 — Componentes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="306" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b20" value="Paquetes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="306" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b21" value="Equipo de desarrollo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="306" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b22" value="Física" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8_b23" value="¿Dónde se ejecuta cada pieza?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="376" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8_b24" value="Nivel 2 — Contenedores" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="376" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b25" value="Despliegue" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="376" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b26" value="Infraestructura · DevOps" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="376" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b27" value="+1 Escenarios" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#E8F2E8;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="446" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8_b28" value="¿Todo lo anterior funciona junto?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="446" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8_b29" value="Nivel 1 — Contexto" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="446" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b30" value="Casos de uso · Secuencia" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="446" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b31" value="Todos, incluido el cliente" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="446" width="200" height="70" as="geometry"/></mxCell><mxCell id="p8_b32" value="&lt;b&gt;Por qué son dos lenguajes y no uno:&lt;/b&gt; 4+1 dice &lt;i&gt;qué perspectivas&lt;/i&gt; hay que documentar; C4 dice &lt;i&gt;cómo dibujarlas&lt;/i&gt; con niveles de zoom coherentes. No compiten: se complementan.&lt;br&gt;&lt;br&gt;&lt;b&gt;Para el documento de Booker&lt;/b&gt; basta con los niveles 1, 2 y 3 de C4, más los diagramas UML de clases, secuencia y despliegue." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="536" width="1020" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>