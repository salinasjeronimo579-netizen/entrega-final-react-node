<mxfile host="app.diagrams.net" agent="SENA ADSO - Booker" type="device"><diagram name="0. Cómo usar este archivo" id="d0"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0_b1" value="&lt;b&gt;Diagramas de arquitectura — Booker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p0_b2" value="&lt;b&gt;Para qué sirve este archivo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Contiene el documento de arquitectura del sistema Booker (gestión de biblioteca), dibujado siguiendo el modelo C4 y los diagramas UML complementarios, con base en los requerimientos y el MER ya definidos para el proyecto.&lt;br&gt;&lt;br&gt;Cada página corresponde a una vista distinta del sistema, desde el contexto general hasta el detalle de componentes, clases, secuencia y despliegue." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="500" height="300" as="geometry"/></mxCell><mxCell id="p0_b3" value="&lt;b&gt;Páginas&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. C4 nivel 1 — Contexto&lt;br&gt;2. C4 nivel 2 — Contenedores&lt;br&gt;3. C4 nivel 3 — Componentes de la API&lt;br&gt;4. UML — Diagrama de clases&lt;br&gt;5. UML — Diagrama de secuencia&lt;br&gt;6. UML — Diagrama de despliegue&lt;br&gt;7. Escenario de calidad&lt;br&gt;8. Mapa — Vistas 4+1 y C4" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="468" height="300" as="geometry"/></mxCell><mxCell id="p0_b4" value="&lt;b&gt;Reglas que se aplican en todos los diagramas de este documento&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Toda caja dice qué tecnología representa.  · Toda flecha dice qué viaja por ella y con qué protocolo.  · Ningún diagrama mezcla niveles de zoom (usuarios, módulos y servidores en la misma lámina).  · Todo diagrama va acompañado de un párrafo que lo explica: un dibujo solo nunca se entrega." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="1008" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="1. C4 Contexto" id="d1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_b1" value="&lt;b&gt;C4 · Nivel 1 — Diagrama de contexto&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p1_b2" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Estudiante o docente. Consulta el catálogo y su historial de préstamos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1_b3" value="&lt;b&gt;Bibliotecario&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Gestiona el inventario, registra préstamos y devoluciones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1_b4" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Gestiona usuarios del sistema, permisos y consulta reportes generales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1_b5" value="&lt;b&gt;Booker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Gestiona el catálogo de libros, los ejemplares, los préstamos, las reservas y las multas de la biblioteca.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="260" width="260" height="160" as="geometry"/></mxCell><mxCell id="p1_e1" value="Consulta catálogo e historial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_b2" target="p1_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="Gestiona préstamos y devoluciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_b3" target="p1_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="Gestiona usuarios y permisos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_b4" target="p1_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_b6" value="&lt;b&gt;Qué responde este nivel:&lt;/b&gt; ¿quiénes usan el sistema? Nada más. Aquí no van tecnologías internas, ni bases de datos, ni módulos.&lt;br&gt;&lt;b&gt;Sin sistemas externos:&lt;/b&gt; según los requerimientos iniciales, esta iteración no integra correo automático ni APIs de terceros — queda fuera de alcance por el momento.&lt;br&gt;&lt;b&gt;Público:&lt;/b&gt; cualquier persona, incluso sin perfil técnico." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="300" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. C4 Contenedores" id="d2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_b1" value="&lt;b&gt;C4 · Nivel 2 — Diagrama de contenedores&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p2_b2" value="&lt;b&gt;Usuario del sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Usuario, bibliotecario o administrador.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="p2_b3" value="Booker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="660" height="560" as="geometry"/></mxCell><mxCell id="p2_b4" value="&lt;b&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Contenedor: React 19 + Vite + Tailwind CSS v4 + React Router v7]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SPA que permite iniciar sesión, consultar el catálogo, y —según el rol— gestionar libros, préstamos, usuarios y reportes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="250" height="130" as="geometry"/></mxCell><mxCell id="p2_b5" value="&lt;b&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Contenedor: Node.js + Express]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Expone las operaciones de usuarios, catálogo, préstamos, reservas y multas. Valida el token y el permiso por rol.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="260" height="130" as="geometry"/></mxCell><mxCell id="p2_b6" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Contenedor: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Guarda usuarios, libros, autores, ejemplares, préstamos, reservas y multas (22 tablas del MER de Booker).&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="480" y="560" width="260" height="100" as="geometry"/></mxCell><mxCell id="p2_e1" value="Usa [navegador]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p2_b2" target="p2_b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e2" value="Consume [HTTPS/JSON]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p2_b4" target="p2_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e3" value="Lee y escribe [SQL/TCP vía Sequelize]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;" edge="1" parent="1" source="p2_b5" target="p2_b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_b7" value="&lt;b&gt;El diagrama más importante del documento.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un &lt;i&gt;contenedor&lt;/i&gt; en C4 es cualquier cosa que se despliega y se ejecuta por separado: una app, una API, una base de datos. No tiene relación con Docker.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fíjense:&lt;/b&gt; cada caja dice su tecnología y cada flecha dice el protocolo. Por ahora solo hay un contenedor de cliente (aplicación web): la API da soporte únicamente a la versión web en esta iteración." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="200" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. C4 Componentes" id="d3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_b1" value="&lt;b&gt;C4 · Nivel 3 — Componentes del contenedor «API REST»&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p3_b2" value="&lt;b&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Contenedor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cliente de la API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="100" as="geometry"/></mxCell><mxCell id="p3_b3" value="Contenedor: API REST (Node.js + Express)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="990" height="700" as="geometry"/></mxCell><mxCell id="p3_b4" value="&lt;b&gt;Seguridad&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: middleware JWT + bcrypt]&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Intercepta toda petición: autentica usuario/contraseña y valida el rol (Administrador, Bibliotecario, Usuario) antes de dejarla pasar a un controller.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="900" height="100" as="geometry"/></mxCell><mxCell id="p3_b5" value="&lt;b&gt;Controller de Usuarios&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Express Router + Controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Endpoints de registro, edición, eliminación y consulta de usuarios.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="200.0" height="120" as="geometry"/></mxCell><mxCell id="p3_b6" value="&lt;b&gt;Controller de Catálogo&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Express Router + Controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Endpoints de libros, autores y ejemplares.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520.0" y="330" width="200.0" height="120" as="geometry"/></mxCell><mxCell id="p3_b7" value="&lt;b&gt;Controller de Préstamos y Reservas&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Express Router + Controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Endpoints de préstamo, devolución e historial.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="740.0" y="330" width="240.0" height="120" as="geometry"/></mxCell><mxCell id="p3_b8" value="&lt;b&gt;Controller de Multas&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Express Router + Controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Endpoints de consulta y pago de multas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000.0" y="330" width="200.0" height="120" as="geometry"/></mxCell><mxCell id="p3_b9" value="&lt;b&gt;Services (lógica de negocio)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Services por módulo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Reglas: valida disponibilidad de ejemplares, calcula fechas de devolución, genera multas por atraso, actualiza el estado del ejemplar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="510" width="900" height="110" as="geometry"/></mxCell><mxCell id="p3_b10" value="&lt;b&gt;Acceso a datos&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Componente: Sequelize — Models con prefijo «Model»]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Un Model por tabla (ModelUsuario, ModelLibro…). Mapeo objeto-tabla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="900" height="100" as="geometry"/></mxCell><mxCell id="p3_b11" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Contenedor: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Persistencia.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="670" width="170" height="100" as="geometry"/></mxCell><mxCell id="p3_e1" value="HTTPS/JSON + token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b2" target="p3_b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e2" value="Petición autenticada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.111;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b4" target="p3_b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e3" value="Petición autenticada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.356;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b4" target="p3_b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e4" value="Petición autenticada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.622;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b4" target="p3_b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e5" value="Petición autenticada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.889;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b4" target="p3_b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e6" value="Invoca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.111;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b5" target="p3_b9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e7" value="Invoca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.356;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b6" target="p3_b9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e8" value="Invoca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#707070;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=