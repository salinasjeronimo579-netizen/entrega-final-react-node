=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="170" width="220" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. UML Clases" id="d4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="970" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_b1" value="&lt;b&gt;UML · Diagrama de clases (modelo de dominio)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Booker — Sistema de gestión de biblioteca&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="46" as="geometry"/></mxCell><mxCell id="p4_c1" value="Usuario" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="230" height="138" as="geometry"/></mxCell><mxCell id="p4_f1" value="- id: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="p4_c1"><mxGeometry x="0" y="28" width="230" height="22" as="geometry"/></mxCell><mxCell id="p4_f2" value="- nombre: string" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="p4_c1"><mxGeometry x="0" y="50" width="230" height="22" as="geometry"/></mxCell><mxCell id="p4_f3" value="- correo: string" style="text;strokeColor=