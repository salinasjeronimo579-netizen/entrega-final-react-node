        <mxCell id="tit" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F5C2E;" value="&lt;b&gt;Arquitectura por capas (n-capas) - Booker&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Sistema de gestión de biblioteca. Cada capa solo depende de la capa inmediatamente inferior.&lt;/font&gt;" vertex="1">
