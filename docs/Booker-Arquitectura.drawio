          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="l4" value="depende de">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;Regla de oro&lt;/b&gt;&lt;br&gt;&lt;br&gt;Las flechas van siempre hacia abajo.&lt;br&gt;&lt;br&gt;PostgreSQL nunca conoce a React: si la capa de datos conociera a la de presentación, habría dependencia circular." vertex="1">
          <mxGeometry height="180" width="260" x="960" y="100" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;Convenciones del proyecto&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ES Modules (import/export), no CommonJS.&lt;br&gt;- Models: prefijo &amp;quot;Model&amp;quot; (ModelUsuario.js).&lt;br&gt;- Controllers: prefijo &amp;quot;Controller&amp;quot; (ControllerUsuario.js).&lt;br&gt;- Repo: entrega-final-node." vertex="1">
          <mxGeometry height="150" width="260" x="960" y="300" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;Ventajas para Booker:&lt;/b&gt; separación clara entre UI, reglas de préstamos/multas y persistencia; fácil de probar por capas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Desventajas:&lt;/b&gt; agregar un campo puede tocar Model + Service + Controller + Vista; sigue siendo un único desplegable (no microservicios)." vertex="1">
          <mxGeometry height="120" width="700" x="220" y="720" as="geometry" />
        </mxCell>
      </root>
