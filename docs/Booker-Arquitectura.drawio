        <mxCell id="l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacing=8;" value="&lt;b&gt;Capa de acceso a datos&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Sequelize (ORM) — un Model por tabla, prefijo &amp;quot;Model&amp;quot; (ej. ModelUsuario, ModelLibro), consultas y mapeo objeto-tabla&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="700" x="220" y="390" as="geometry" />
